@inherits WebViewPage<PagedDataModel>

@{
	var CmsPage = PagePayload.GetContent(Model.SiteNav);
	CmsPage.TypeLabelPrefixes = CmsPage.GetDefaultTypeHeadingOptions();

	var pager = new PagedDataSummary();

	pager.ContentType = Model.ContentType;
	pager.MaxPage = Model.MaxPage;
	pager.PageSize = Model.PageSize;
	pager.IgnoreSitePath = false;
	pager.SelectedCategorySlugs = Model.SelectedCategorySlugs;

	pager.FetchData();
}

@if (pager != null && pager.DataSource != null) {
	<div class="result-content @Model.CSSPageListing">
		<br style="clear: both;" />
		@foreach (var item in pager.DataSource) {
			var usr = item.BylineUser;
			<div class="result-content @Model.CSSPageListing">
				<p>
					@if (item.ContentType == ContentPageType.PageType.BlogEntry) {
						<b class="index-head">
							<a href="@item.FileName">@item.NavigationText</a>
							&nbsp;|&nbsp; @string.Format(" {0:d} ", item.GoLiveDate)
						</b>
						<div>
							<br />
							by @usr.FullName_FirstLast
						</div>
					} else {
						<b class="index-head">
							<a href="@item.FileName">@item.NavigationText</a>
						</b>
					}
				</p>
				<p>
					@item.PageTextPlainSummary
				</p>

				<p class="post-footer align-right">
					<a class="readmore" href="@item.FileName">Read more</a>
					<span class="comments">
						@string.Format("  Comments ({0})  ", item.CommentCount)
					</span>
				</p>
			</div>
		}

		@if (Model.ShowPager) {
			<div class="pagerfooterlinks @Model.CSSPageFooter">
				@foreach (var i in pager.PageNumbers) {
					using (CarrotWeb.BeginWrappedItem("div", i, pager.PageNumber, new { @class = "pagerlink selectedwrap " + Model.CSSSelectedPage }, new { @class = "pagerlink" })) {
						using (CarrotWeb.BeginWrappedItem("a", i, pager.PageNumber, new { @class = "selected " + Model.CSSSelectedPage, @href = pager.GetUrl(i) }, new { @href = pager.GetUrl(i) })) {
							@String.Format(" {0} ", i)
						}
					}
				}
			</div>
		}

	</div>
	<div style="clear: both;">
	</div>
}

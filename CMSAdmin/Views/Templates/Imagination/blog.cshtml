@inherits CmsWebViewPage

@{
	Layout = "_main.cshtml";

	ViewBag.BodyCssClass = "not-homepage";

	var cats = CmsPage.GetSiteCategories(10, true);
	var tags = CmsPage.GetSiteTags(10, true);

	var pagecat = CmsPage.GetPageCategories(10);
	var pagetag = CmsPage.GetPageTags(10);

	var usr = CmsPage.BylineUser;

}

@section Banner {
	<!-- Banner -->
	<div id="banner">
		<div class="container">
		</div>
	</div>
	<!-- /Banner -->
}

<!-- Main -->
<div id="main">
	<div class="container">
		<div class="row">
			<div class="3u">
				@Html.Partial("_blogNav")
			</div>

			<div class="9u skel-cell-important">
				<section>
					<article>
						<header>
							<h2>@CmsPage.Heading</h2>
							<span class="byline">
								By
								@usr.FullName_FirstLast
							</span>
						</header>

						<div>
							@CarrotCakeHtml.RenderWidget("phCenterTop")
						</div>

						@CarrotCakeHtml.RenderBody()

						<div>
							@CarrotCakeHtml.RenderWidget("phCenterBottom")
						</div>
						@if (cats.Any()) {
							<div class="meta">
								@foreach (var itm in pagecat) {
									<span class="meta-item"><a href="@itm.Uri">@itm.Text</a></span>
								}
							</div>
						}
						@if (tags.Any()) {
							<div class="meta">
								@foreach (var itm in pagetag) {
									<span class="meta-item"><a href="@itm.Uri">@itm.Text</a></span>
								}
							</div>
						}
					</article>
				</section>
				<section>
					@Html.Partial("_contactus")
				</section>
			</div>
		</div>
	</div>
</div>
<!-- Main -->